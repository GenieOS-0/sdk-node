{
  "name": "@mailgenius/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript / Node.js SDK for the MailGenius API. Templates, sequences, events, webhooks, schema-contract — typed, retried, idempotent.",
  "license": "Apache-2.0",
  "homepage": "https://mailgenius.pro/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mail-genius/mailgenius.git",
    "directory": "packages/sdk-node"
  },
  "keywords": [
    "mailgenius",
    "email",
    "transactional",
    "marketing",
    "sequences",
    "schema-contract",
    "mcp"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.mjs",
      "require": "./dist/webhooks.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/webhooks.ts --format esm,cjs --dts --clean --target node18",
    "test": "node --test --import tsx ./test/**/*.test.ts",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
